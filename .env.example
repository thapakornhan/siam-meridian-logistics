# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit real values.
# In production, set these in Cloudflare Pages → Settings → Variables and Secrets.
# ---------------------------------------------------------------------------

# Public (safe to expose; used at build time) ------------------------------
# Your live site address, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
PUBLIC_SITE_URL=https://www.siam-meridian-logistics.com
# Cloudflare Turnstile SITE key (public). The value below is Cloudflare's always-pass TEST key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

---
import { ui, type Lang } from '../i18n/ui';
import { data, services, formSettings } from '../lib/content';
interface Props { lang: Lang; kind: 'quote' | 'contact' }
const { lang, kind } = Astro.props;
const t = ui[lang];
const f = t.form;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const msgs = { ...f.err, errorTitle: f.errorTitle, sending: f.sending, email: data.contact.email };
const isQuote = kind === 'quote';

type Def = { name: string; type?: 'input' | 'select' | 'textarea'; full?: boolean; locked?: boolean; max: number; label: string; ph?: string; attrs?: Record<string, string> };
const quoteDefs: Def[] = [
  { name: 'name', locked: true, max: 120, label: f.fullName, attrs: { autocomplete: 'name' } },
  { name: 'company', max: 160, label: f.company, attrs: { autocomplete: 'organization' } },
  { name: 'email', locked: true, max: 160, label: f.email, attrs: { type: 'email', autocomplete: 'email', inputmode: 'email' } },
  { name: 'phone', max: 40, label: f.phone, attrs: { type: 'tel', autocomplete: 'tel', inputmode: 'tel' } },
  { name: 'service', type: 'select', full: true, max: 40, label: f.serviceType },
  { name: 'origin', max: 160, label: f.origin, ph: f.ph.origin },
  { name: 'destination', max: 160, label: f.destination, ph: f.ph.destination },
  { name: 'cargo', type: 'textarea', full: true, max: 2000, label: f.cargo, ph: f.ph.cargo },
  { name: 'weight', max: 80, label: f.weight, ph: f.ph.weight },
  { name: 'volume', max: 80, label: f.volume, ph: f.ph.volume },
  { name: 'extra', type: 'textarea', full: true, max: 2000, label: f.extra, ph: f.ph.extra }
];
const contactDefs: Def[] = [
  { name: 'name', locked: true, max: 120, label: f.fullName, attrs: { autocomplete: 'name' } },
  { name: 'company', max: 160, label: f.company, attrs: { autocomplete: 'organization' } },
  { name: 'email', locked: true, max: 160, label: f.email, attrs: { type: 'email', autocomplete: 'email', inputmode: 'email' } },
  { name: 'phone', max: 40, label: f.phone, attrs: { type: 'tel', autocomplete: 'tel', inputmode: 'tel' } },
  { name: 'message', type: 'textarea', full: true, locked: true, max: 3000, label: f.message }
];
const cfg = (formSettings as any)[kind] as Record<string, { show: boolean; required: boolean }>;
const fields = (isQuote ? quoteDefs : contactDefs)
  .map((d) => ({ ...d, show: d.locked ? true : cfg[d.name]?.show !== false, required: d.locked ? true : !!cfg[d.name]?.required }))
  .filter((d) => d.show);
const on = new Set<string>([...services.map((s) => s.slug), 'other']);
const options = Object.entries(f.serviceOptions).filter(([v]) => on.has(v));
const id = (n: string) => `${kind}-${n}`;
---
<div class="form-card" data-form-wrap>
  <div class="notice notice--ok" data-success hidden role="status" tabindex="-1">
    <h3>{f.successTitle}</h3>
    <p>{isQuote ? f.successQuote : f.successContact}</p>
    <p style="margin-top:12px"><button type="button" class="link-arrow" style="background:none;border-width:0 0 2px;cursor:pointer" data-reset>{f.sendAnother}</button></p>
  </div>
  <div class="notice notice--err" data-error hidden role="alert" tabindex="-1">
    <h3>{f.errorTitle}</h3>
    <p data-error-text></p>
  </div>

  <form data-form novalidate data-endpoint="/api/submit" data-kind={kind} data-msgs={JSON.stringify(msgs)} aria-label={isQuote ? f.submitQuote : f.submitContact}>
    <input type="hidden" name="kind" value={kind} />
    <input type="hidden" name="lang" value={lang} />
    <input type="hidden" name="started" value="" />
    <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

    <div class="form-grid">
      {fields.map((d) => (
        <div class={`field${d.full ? ' full' : ''}`}>
          <label for={id(d.name)}>{d.label}{!d.required && <span class="opt"> ({f.optional})</span>}</label>
          {d.type === 'select' ? (
            <select id={id(d.name)} name={d.name} required={d.required} aria-describedby={`${id(d.name)}-err`}>
              <option value="">{f.selectService}</option>
              {options.map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
          ) : d.type === 'textarea' ? (
            <textarea id={id(d.name)} name={d.name} required={d.required} maxlength={d.max} placeholder={d.ph} aria-describedby={`${id(d.name)}-err`}></textarea>
          ) : (
            <input id={id(d.name)} name={d.name} required={d.required} maxlength={d.max} placeholder={d.ph} aria-describedby={`${id(d.name)}-err`} {...(d.attrs ?? {})} />
          )}
          <span class="field-error" id={`${id(d.name)}-err`}></span>
        </div>
      ))}
    </div>

    <div class="turnstile">
      {siteKey
        ? <div class="cf-turnstile" data-sitekey={siteKey} data-language={lang} data-theme="light"></div>
        : <p class="form-note" style="color:var(--danger)">Turnstile site key missing (set PUBLIC_TURNSTILE_SITE_KEY).</p>}
    </div>

    <div class="form-actions">
      <button class="btn btn--navy" type="submit" data-submit>{isQuote ? f.submitQuote : f.submitContact}</button>
      <span class="form-note" style="margin:0">{f.privacyNote}</span>
    </div>
  </form>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</div>

<script>
  import '../scripts/form.ts';
</script>

---
/** Brand motif: meridian globe grid + the logo's sweeping ribbon. Pure SVG, no image weight. */
const cx = 600, cy = 430, R = 330;
const meridians = [70, 150, 235, 330];
const parallels = [-60, -30, 0, 30, 60].map((lat) => {
  const a = (lat * Math.PI) / 180;
  return { rx: R * Math.cos(a), cy: cy + R * Math.sin(a) * 0.9, ry: R * Math.cos(a) * 0.16 };
});
---
<div class="hero-bg" aria-hidden="true">
  <svg viewBox="0 0 1200 860" fill="none">
    <defs>
      <linearGradient id="gold-line" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#b8893a" stop-opacity="0" />
        <stop offset=".35" stop-color="#d9b566" />
        <stop offset="1" stop-color="#f0d9a0" />
      </linearGradient>
      <linearGradient id="blue-ribbon" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#1b4f8c" stop-opacity="0" />
        <stop offset=".5" stop-color="#2a6cb8" stop-opacity=".55" />
        <stop offset="1" stop-color="#1b4f8c" stop-opacity=".1" />
      </linearGradient>
    </defs>
    <g stroke="#c9d3e0" stroke-opacity=".16" stroke-width="1.2">
      <circle cx={cx} cy={cy} r={R} />
      {meridians.map((rx) => <ellipse cx={cx} cy={cy} rx={rx} ry={R} />)}
      <line x1={cx} y1={cy - R} x2={cx} y2={cy + R} />
      {parallels.map((p) => <ellipse cx={cx} cy={p.cy} rx={p.rx} ry={p.ry} />)}
    </g>
    <path d="M10 700 C 300 830, 560 470, 800 520 S 1090 330, 1190 110" stroke="url(#blue-ribbon)" stroke-width="64" stroke-linecap="round" />
    <path class="draw" pathLength="1" d="M10 700 C 300 830, 560 470, 800 520 S 1090 330, 1190 110" stroke="url(#gold-line)" stroke-width="3" stroke-linecap="round" />
    <path class="draw" pathLength="1" d="M10 740 C 320 860, 590 520, 820 565 S 1100 390, 1195 190" stroke="#d9b566" stroke-opacity=".35" stroke-width="1.5" stroke-linecap="round" />
  </svg>
</div>

---
import LangSwitch from './LangSwitch.astro';
import { ui, type Lang } from '../i18n/ui';
import { href } from '../lib/i18n';
import { services, data } from '../lib/content';
import { getChannels, channelHref } from '../lib/channels';
interface Props { lang: Lang; links: { lang: Lang; href: string; current: boolean }[] }
const { lang, links } = Astro.props;
const t = ui[lang];
const c = data.contact;
const s = data.settings;
const names = t.channelNames as Record<string, string>;
const channels = getChannels('footer');
---
<footer class="site-footer on-dark">
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="brand" href={href(lang)}><img src="/brand/logo-sm.png" width="420" height="299" alt="Siam Meridian Logistics Co., Ltd." loading="lazy" /></a>
      <p>{s[lang].tagline}</p>
    </div>
    <div>
      <h3>{t.footer.explore}</h3>
      <ul>
        <li><a href={href(lang)}>{t.nav.home}</a></li>
        <li><a href={href(lang, '/about/')}>{t.nav.about}</a></li>
        <li><a href={href(lang, '/news/')}>{t.nav.news}</a></li>
        <li><a href={href(lang, '/contact/')}>{t.nav.contact}</a></li>
        <li><a href={href(lang, '/get-a-quote/')}>{t.nav.quote}</a></li>
      </ul>
    </div>
    <div>
      <h3>{t.footer.services}</h3>
      <ul>{services.map((sv) => <li><a href={href(lang, `/services/${sv.slug}/`)}>{sv[lang].title}</a></li>)}</ul>
    </div>
    <div>
      <h3>{t.footer.contact}</h3>
      <address>
        <span>{c[lang].address}</span>
        {channels.map((ch) => {
          const h = channelHref(ch);
          const txt = ch.type === 'phone' || ch.type === 'email' ? ch.value : `${names[ch.type] ?? names.other}: ${ch.value}`;
          return h ? <a href={h} {...(/^https?:/.test(h) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{txt}</a> : <span>{txt}</span>;
        })}
      </address>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {s[lang].footer_note}</span>
    <span class="footer-meta"><a href={href(lang, '/privacy/')}>{t.footer.privacy}</a><LangSwitch lang={lang} links={links} /></span>
  </div>
</footer>

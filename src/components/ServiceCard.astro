---
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';
import { href } from '../lib/i18n';
import type { Service } from '../lib/content';
interface Props { svc: Service; lang: Lang }
const { svc, lang } = Astro.props;
---
<a class="service-card" href={href(lang, `/services/${svc.slug}/`)}>
  <span class="icon-plate"><Icon name={svc.icon} /></span>
  <h3>{svc[lang].title}</h3>
  <p>{svc[lang].summary}</p>
  <span class="link-arrow">{ui[lang].learnMore}<Icon name="arrow" /></span>
</a>

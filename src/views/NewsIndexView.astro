---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { ui, type Lang } from '../i18n/ui';
import { href } from '../lib/i18n';
import { data, getArticles, formatDate } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = data.news[lang];
const t = ui[lang];
const articles = getArticles(lang);
---
<Base lang={lang} title={c.seo_title} description={c.seo_description} path="/news/">
  <PageHero title={c.title} intro={c.intro} />
  <section class="section">
    <div class="wrap">
      {articles.length === 0 ? <p class="empty">{c.empty}</p> : (
        <div class="grid grid-3">
          {articles.map((a) => (
            <a class="news-card" href={href(lang, `/news/${a.slug}/`)}>
              {a.image ? <img src={a.image} alt="" loading="lazy" /> : <div class="ph"></div>}
              <div class="body">
                <time datetime={a.date.toISOString().slice(0, 10)}>{formatDate(a.date, lang)}</time>
                <h3>{a.title}</h3>
                <p>{a.summary}</p>
                <span class="link-arrow" style="align-self:flex-start">{t.readMore}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import type { Lang } from '../i18n/ui';
import { data } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = data.privacy[lang];
---
<Base lang={lang} title={c.seo_title} description={c.seo_description} path="/privacy/" quoteBar={false}>
  <PageHero title={c.title} />
  <section class="section"><div class="wrap"><div class="prose">{c.sections.map((s) => <><h2>{s.heading}</h2><p>{s.body}</p></>)}</div></div></section>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ChannelCard from '../components/ChannelCard.astro';
import { getChannels } from '../lib/channels';
import type { Lang } from '../i18n/ui';
import { data } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = data.quote[lang];
---
<Base lang={lang} title={c.seo_title} description={c.seo_description} path="/get-a-quote/" quoteBar={false}>
  <PageHero title={c.title} intro={c.intro} />
  <section class="section">
    <div class="wrap form-layout">
      <InquiryForm lang={lang} kind="quote" />
      <aside class="form-aside">{getChannels('home').map((ch) => <ChannelCard c={ch} lang={lang} />)}</aside>
    </div>
  </section>
</Base>

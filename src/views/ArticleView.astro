---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { ui, LANGS, type Lang } from '../i18n/ui';
import { href } from '../lib/i18n';
import { getArticles, formatDate } from '../lib/content';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = ui[lang];
const article = getArticles(lang).find((a) => a.slug === slug)!;
const langs = LANGS.filter((l) => getArticles(l).some((a) => a.slug === slug));
const { Content } = article;
---
<Base lang={lang} title={article.title} description={article.seoDescription || article.summary} path={`/news/${slug}/`}
  langs={langs} altFallback="/news/" image={article.image} type="article">
  <PageHero title={article.title}>
    <p slot="crumbs" class="crumbs"><a href={href(lang, '/news/')}>{t.nav.news}</a> / <time datetime={article.date.toISOString().slice(0, 10)}>{formatDate(article.date, lang)}</time></p>
  </PageHero>
  <article class="section">
    <div class="wrap">
      <div class="prose">
        {article.image && <img class="article-cover" src={article.image} alt="" />}
        <Content />
        <p style="margin-top:40px"><a class="link-arrow" href={href(lang, '/news/')}>{t.backToNews}</a></p>
      </div>
    </div>
  </article>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { ui, type Lang } from '../i18n/ui';
import { data, services } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = data.home[lang];
const t = ui[lang];
---
<Base lang={lang} title={t.nav.services} description={h.services_intro} path="/services/">
  <PageHero title={h.services_title} intro={h.services_intro} />
  <section class="section"><div class="wrap grid grid-2">{services.map((s) => <ServiceCard svc={s} lang={lang} />)}</div></section>
  <CtaBand tight lang={lang} title={h.cta_title} body={h.cta_body} button={h.cta_button} />
</Base>
